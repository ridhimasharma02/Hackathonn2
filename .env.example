# StockSense Environment Configuration Example

# Application Secrets
SECRET_KEY=stocksense_dev_secret_key_change_in_production
JWT_SECRET=env_app_secret_production_key_2026_stocksense

# Database Configuration
# Leave unset or empty for zero-config SQLite local development (instance/stocksense.db)
# Or configure PostgreSQL for production:
DATABASE_URL=postgresql://stock_usr:stock_pwd@localhost:5432/stocksense

# In-Memory Cache (Redis 7)
# Leave unset or empty to use automatic transparent thread-safe in-memory cache
REDIS_URL=redis://localhost:6379/0

# Server Configuration
HOST=0.0.0.0
PORT=5001
NO_BROWSER=0
